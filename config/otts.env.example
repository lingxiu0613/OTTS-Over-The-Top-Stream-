# OTTS runtime configuration.
# Copy to config/otts.env and edit. Shell environment variables still override these values.

OTTS_CONFIG_JSON=/home/nolovr/Downloads/otts/config/otts.config.json

# Security: leave both empty for local open development.
# OTTS_STREAM_TOKEN=change-me
# OTTS_AUTH_SECRET=change-this-secret
OTTS_AUTH_TTL_SECONDS=3600

# Public host used in generated URLs and edge protocol status.
OTTS_PUBLIC_HOST=192.168.40.11
OTTS_RTSP_PUBLIC_HOST=192.168.40.11
OTTS_SRT_PUBLIC_HOST=192.168.40.11

# Core and control plane ports.
OTTS_RTMP_PORT=1935
OTTS_HTTP_API_PORT=8080
OTTS_COMPAT_HTTP_PORT=1985
PORT=3000
HTTPS_PORT=3443
OTTS_WEBRTC_GATEWAY_PORT=8081
OTTS_RTSP_PUBLISH_PORT=8554
OTTS_RTSP_PLAY_PORT=8556
OTTS_RTSP_PLAY_COMPAT_ENABLED=false
# Native C++ RTSP play port. Leave 0 to disable the native listener.
OTTS_CPP_RTSP_PLAY_PORT=8556
OTTS_SRT_PUBLISH_PORT_BASE=9000
OTTS_SRT_PLAY_PORT_BASE=10000

# Internal service URLs.
OTTS_API_BASE=http://127.0.0.1:8080
OTTS_WEBRTC_GATEWAY_BASE=http://127.0.0.1:8081
OTTS_RTMP_BASE=rtmp://127.0.0.1:1935

# Keep RTSP and SRT on their native C++ listeners. The migration modes below
# are compatibility fallbacks used only when native-only mode is disabled.
OTTS_NATIVE_PROTOCOL_ONLY=true
OTTS_RTSP_PUBLISH_MODE=core-direct-flv
OTTS_RTSP_PLAY_MODE=core-egress-flv
OTTS_SRT_PUBLISH_MODE=core-direct-flv
OTTS_SRT_PLAY_MODE=core-egress-flv

# Tools and storage.
OTTS_FFMPEG_BIN=ffmpeg
OTTS_RECORDING_ROOT=/tmp/otts_recordings
OTTS_LOG_LEVEL=info

# Stability cleanup.
OTTS_CLEANUP_INTERVAL_MS=5000
OTTS_EXTERNAL_PUBLISHER_IDLE_MS=30000
OTTS_STOPPED_SESSION_RETENTION_MS=60000
